 "sources": {
  "jericho": {
   "caveat": "Annual shares only. Its hourly series cannot be used: carriers are a fixed scalar times one shared profile, so their correlation is 1.000000 and the composition is identical across all 38 regions to 4e-8 while regional scale varies 17.9x.",
   "citation": "Priesmann J, Nolting L, Kockel C, Praktiknjo A. Time series of useful energy consumption patterns for energy system modeling (JERICHO-E-usage). Scientific Data 8:148, 2021. doi:10.1038/s41597-021-00907-w",
   "kind": "useful energy by carrier, annual totals",
   "peer_reviewed": true,
   "scope": "German industry, 2019, 38 NUTS2 regions"
  },
  "naegler": {
   "caveat": "German shares from 2006, which the paper itself transfers to every EU28 country; it notes that the branch definitions are not well documented in its source. Heat only: no cooling and no electricity. Digitised from Fig. 3 (dataset DS2-1) to about +-1 percentage point. Steel and non-ferrous metals share one profile, as do minerals and mining, and construction and other.",
   "citation": "Naegler T, Simon S, Klein M, Gils HC. Quantification of the European industrial heat demand by branch and temperature level. International Journal of Energy Research 39(15):2019-2030, 2015. doi:10.1002/er.3436",
   "kind": "heat by temperature level, shares of branch heat demand",
   "peer_reviewed": true,
   "scope": "German industry, 2006, 13 branches"
  },
  "rehfeldt": {
   "caveat": "Final energy: heat is the fuel burnt for it and cooling the electricity that drives it, so its heat:cold is not the delivered ratio generate() takes. Digitised from Fig. 16 to about +-1 percentage point; slices under 1 point cannot be read, and the FORECAST bars of machinery and transport, non-metallic minerals and other industry each show a hairline that may hold up to 1 % cooling. Its two datasets disagree by more than some subsectors differ, so a subsector is a range, never a point.",
   "citation": "Rehfeldt M, Fleiter T, Toro F. A bottom-up estimation of the heating and cooling demand in European industry. Energy Efficiency 11:1057-1082, 2018. doi:10.1007/s12053-017-9571-y",
   "kind": "heating and cooling by temperature band, shares of subsector final energy",
   "peer_reviewed": true,
   "scope": "UK industry, 7 subsectors, two datasets (ECUK and FORECAST)"
  },
  "tno": {
   "caveat": "No electricity and essentially no refrigeration. Its waste heat is rejected above ambient and is a heat pump source, not a cooling demand.",
   "citation": "Marina A, Spoelstra S, Zondag HA, Wemmers AK. An estimation of the European industrial heat pump market potential. Renewable and Sustainable Energy Reviews 139:110545, 2021. doi:10.1016/j.rser.2020.110545",
   "kind": "process and waste heat quantities with stream temperatures",
   "peer_reviewed": true,
   "scope": "EU-28, 2016 production, 4 sectors, ~66 products"
  }
 },
